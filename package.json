{
  "name": "t3ctl",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Local CLI for controlling an already-running T3 Code app",
  "type": "module",
  "bin": {
    "t3ctl": "./dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "tsc -p tsconfig.json",
    "test": "T3CTL_CONFIG_DIR=$(mktemp -d) node --import tsx --test \"test/*.test.ts\"",
    "record-fixtures": "tsx test/record-fixtures.ts"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "croner": "^10.0.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  },
  "packageManager": "pnpm@10.34.5",
  "files": [
    "dist"
  ]
}
